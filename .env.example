# Server & Authentication
PORT=3001
# Set a password to protect your web UI (leave empty to disable auth if using Tailscale/VPN)
AUTH_PASSWORD=antigravity-admin

# Antigravity CLI Configuration
# Path to the agy binary (inside Docker this is mounted at /usr/local/bin/agy)
AGY_BIN=agy
# Default working directory where agy will execute commands
AGY_DEFAULT_CWD=/home/albert/Documents/Projects
# Path to .gemini directory containing antigravity-cli auth and transcripts
AGY_DATA_DIR=/home/albert/.gemini/antigravity-cli

# Execution Mode: "local" (runs agy directly in container/host) or "ssh" (runs agy over SSH on the host)
AGY_EXEC_MODE=local

# Optional: Host SSH settings (used when AGY_EXEC_MODE=ssh)
SSH_HOST=host.docker.internal
SSH_PORT=22
SSH_USER=root
SSH_KEY_PATH=/root/.ssh/id_rsa
